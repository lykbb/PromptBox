{
  "name": "promptbox",
  "private": true,
  "version": "0.1.0",
  "description": "从你和 AI 的对话里提炼提示词和规则，再按你的风格写新的。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package:mac": "bash scripts/package-mac.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
